{
  "name": "dure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js chat",
    "chat": "tsx --env-file=.env src/main.ts chat",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@sinclair/typebox": "^0.34.48"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
